{
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "name": "gyp-sum",
  "description": "Calculateur de dosage eau / plâtre pour moulage — calcul précis basé sur la masse volumique du plâtre en poudre (2,58 kg/L). SPA Vue 3, open source.",
  "keywords": [
    "plaster",
    "calculator",
    "moulage",
    "gypsum",
    "vue",
    "vite",
    "plâtre"
  ],
  "homepage": "https://cedric-ruiu.github.io/gyp-sum/",
  "repository": "https://github.com/Cedric-ruiu/gyp-sum.git",
  "author": "Cédric Ruiu <cedric.ruiu@gmail.com>",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite-ssg build",
    "typecheck": "vue-tsc --noEmit",
    "preview": "vite preview",
    "lint": "biome check .",
    "format": "biome check . --write --unsafe"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.5",
    "@types/three": "0.186.0",
    "@vitejs/plugin-vue": "6.0.10",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vite-ssg": "28.3.0",
    "vue-tsc": "3.3.13"
  },
  "packageManager": "yarn@4.13.0",
  "dependencies": {
    "@unhead/vue": "^2.1.17",
    "tailwindcss": "4.3.3",
    "three": "0.186.1",
    "vue": "3.5.44",
    "vue-i18n": "11.4.16",
    "vue-router": "5.4.0"
  }
}
